    <mxGraphModel dx="1420" dy="737" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml RikkeiLogistics_Express_Sequence\n\ntitle Rikkei Logistics Express - Sequence Diagram\n\nactor \&quot;Người gửi\&quot; as NguoiGui\nparticipant \&quot;OrderService\&quot; as OrderService\nparticipant \&quot;DispatchService\&quot; as DispatchService\nparticipant \&quot;NotificationService\&quot; as NotificationService\nactor \&quot;Tài xế\&quot; as TaiXe\n\n== Xác nhận đơn hàng ==\n\nNguoiGui -&gt; OrderService: confirmExpressOrder(orderId)\nactivate OrderService\n\nOrderService --&gt; NguoiGui: orderConfirmed\n\n== Điều phối tài xế ==\n\nOrderService -&gt;&gt; DispatchService: requestDriverAssignment(orderId)\nactivate DispatchService\n\nDispatchService -&gt;&gt; NotificationService: sendDriverOffer(driver, orderId)\nactivate NotificationService\n\nNotificationService -&gt;&gt; TaiXe: newOrderOffer(orderId)\n\ndeactivate NotificationService\ndeactivate OrderService\n\nnote right of NguoiGui\nNgười gửi không phải chờ\ntài xế phản hồi.\nend note\n\n== Phản hồi của tài xế ==\n\nalt Tài xế đồng ý\n\n    TaiXe -&gt; DispatchService: acceptOrder(orderId)\n\n    DispatchService --&gt; TaiXe: acceptConfirmation\n\n    DispatchService -&gt;&gt; OrderService: driverAssigned(orderId)\n    activate OrderService\n\n    OrderService --&gt; DispatchService: assignmentSaved\n\n    deactivate OrderService\n\nelse Tài xế từ chối\n\n    TaiXe -&gt; DispatchService: rejectOrder(orderId)\n\n    DispatchService -&gt; DispatchService: findNextDriver(orderId)\n    activate DispatchService\n    deactivate DispatchService\n\n    DispatchService -&gt;&gt; NotificationService: sendDriverOffer(nextDriver, orderId)\n    activate NotificationService\n\n    NotificationService -&gt;&gt; TaiXe: newOrderOffer(orderId)\n\n    deactivate NotificationService\n\nelse Timeout - Tài xế không phản hồi\n\n    ... Sau thời gian quy định ...\n\n    DispatchService -&gt; DispatchService: handleTimeout(orderId)\n    activate DispatchService\n    deactivate DispatchService\n\n    DispatchService -&gt; DispatchService: findNextDriver(orderId)\n    activate DispatchService\n    deactivate DispatchService\n\n    DispatchService -&gt;&gt; NotificationService: sendDriverOffer(nextDriver, orderId)\n    activate NotificationService\n\n    NotificationService -&gt;&gt; TaiXe: newOrderOffer(orderId)\n\n    deactivate NotificationService\n\nend\n\ndeactivate DispatchService\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jxSN4KyV_lG_PXx0HBWJ-139">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
